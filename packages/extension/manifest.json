{
  "manifest_version": 3,
  "name": "StreamDockBridge Context Provider",
  "version": "1.0.0",
  "description": "Provides current active tab context to local StreamDockBridge service.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}