{
  "manifest_version": 3,
  "name": "StreamDockBridge Context Provider",
  "version": "1.0.0",
  "description": "Provides current active tab context to local StreamDockBridge service.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "key": ""
}
